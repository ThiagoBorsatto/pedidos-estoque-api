# Porta em que a API de Pedidos sobe
PORT=3000

# Endereco da API de Produtos (Spring Boot)
PRODUTO_API_URL=http://localhost:8080

# Arquivo do banco SQLite dos pedidos ( ":memory:" para nao persistir )
DATABASE_FILE=pedidos.db

# Timeout (ms) das chamadas HTTP para a API de Produtos
PRODUTO_API_TIMEOUT_MS=8000
