{
  "name": "pedido-api",
  "version": "1.0.0",
  "description": "API REST de Pedidos (Node + TypeScript) que consome a API de Produtos (Spring Boot)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc",
    "start:prod": "node dist/server.js",
    "menu": "tsx src/cli/menu.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["api", "pedidos", "estoque", "typescript", "express"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
